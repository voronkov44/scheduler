# Application
LOG_LEVEL=DEBUG

# HTTP
API_ADDRESS=:8081
API_TIMEOUT=5s

# PostgreSQL
DB_ADDRESS=postgres://scheduler:scheduler@localhost:5432/scheduler?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# ITMO schedule adapter
ITMO_ADAPTER_URL=http://127.0.0.1:35601
ITMO_ADAPTER_API_TOKEN=change-me
ITMO_ADAPTER_TIMEOUT=10s

# NATS
NATS_URL=nats://localhost:4222
NATS_STREAM=SCHEDULER
NATS_CONSUMER=SCHEDULER_SYNC
